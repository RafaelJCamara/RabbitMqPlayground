{
  "name": "rabbitmq-playground-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "RabbitMQ Playground: a browser-based visual RabbitMQ simulator.",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:pages": "ng build --base-href /RabbitMqPlayground/ && tsx tools/pages/postbuild.ts dist/app/browser",
    "build:e2e": "ng build --configuration e2e --base-href /RabbitMqPlayground/ && tsx tools/pages/postbuild.ts dist/app-e2e/browser",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm run test:libs && npm run test:app",
    "test:libs": "vitest run",
    "test:libs:coverage": "vitest run --coverage",
    "test:app": "ng test --watch=false",
    "test:app:coverage": "ng test --watch=false --coverage",
    "test:e2e": "playwright test",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts --reporter=default --reporter=./tools/bench/summary-reporter.ts",
    "docs:generate": "tsx tools/docs/generate-commands.ts",
    "docs:check": "tsx tools/docs/generate-commands.ts --check"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@foblex/2d": "^1.2.2",
    "@foblex/flow": "19.3.0",
    "@foblex/mediator": "^1.1.3",
    "@foblex/platform": "^1.0.4",
    "@foblex/utils": "^1.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "amqplib": "^2.2.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "lefthook": "^2.1.17",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
