      "source": "docs",
      "vhost": "/orders",
      "destination": "archive",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {
        "x-match": "all",
        "format": "pdf",
        "size": 10,
        "ratio": 1.0,
        "draft": false
      }
    },
    {
      "source": "docs",
      "vhost": "/orders",
      "destination": "billing",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {
        "x-match": "any-with-x",
        "format": "pdf",
        "x-region": "eu",
        "price": -0.5,
        "count": -3
      }
    },
    {
      "source": "docs",
      "vhost": "/orders",
      "destination": "audit",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
