{
  "id": "delivery/a-consumer-that-was-full-comes-back-behind-the-others",
  "kind": "delivery",
  "title": "A consumer that was found to be full is taken out of the turn, and comes back at the end of it when an acknowledgement gives it room (ADR-0008, rule 14)",
  "steps": [
    {
      "op": "queue.declare",
      "name": "jobs",
      "durable": true
    },
    {
      "op": "channel.open",
      "channel": "ch1",
      "prefetch": 1
    },
    {
      "op": "channel.open",
      "channel": "ch2",
      "prefetch": 5
    },
    {
      "op": "basic.consume",
      "channel": "ch1",
      "queue": "jobs",
      "consumer": "c1",
      "ack": "manual"
    },
    {
      "op": "basic.consume",
      "channel": "ch2",
      "queue": "jobs",
      "consumer": "c2",
      "ack": "manual"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m1"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m2"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m3"
    },
    {
      "op": "await.deliveries",
      "count": 3
    },
    {
      "op": "basic.ack",
      "consumer": "c1"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m4"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m5"
    },
    {
      "op": "await.deliveries",
      "count": 5
    }
  ],
  "observed": {
    "deliveries": {
      "c1": [
        {
          "body": "m1",
          "redelivered": false
        },
        {
          "body": "m5",
          "redelivered": false
        }
      ],
      "c2": [
        {
          "body": "m2",
          "redelivered": false
        },
        {
          "body": "m3",
          "redelivered": false
        },
        {
          "body": "m4",
          "redelivered": false
        }
      ]
    },
    "ready": {
      "jobs": []
    }
  }
}
