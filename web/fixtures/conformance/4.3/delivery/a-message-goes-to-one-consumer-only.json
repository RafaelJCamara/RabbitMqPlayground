{
  "id": "delivery/a-message-goes-to-one-consumer-only",
  "kind": "delivery",
  "title": "With two consumers on a queue, the first message goes to exactly one of them",
  "origin": "regression: a message reached both of two consumers of a queue",
  "steps": [
    {
      "op": "queue.declare",
      "name": "jobs",
      "durable": true
    },
    {
      "op": "channel.open",
      "channel": "ch1"
    },
    {
      "op": "channel.open",
      "channel": "ch2"
    },
    {
      "op": "basic.consume",
      "channel": "ch1",
      "queue": "jobs",
      "consumer": "c1",
      "ack": "auto"
    },
    {
      "op": "basic.consume",
      "channel": "ch2",
      "queue": "jobs",
      "consumer": "c2",
      "ack": "auto"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m1"
    },
    {
      "op": "await.deliveries",
      "count": 1
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m2"
    },
    {
      "op": "await.deliveries",
      "count": 2
    }
  ],
  "observed": {
    "deliveries": {
      "c1": [
        {
          "body": "m1",
          "redelivered": false
        }
      ],
      "c2": [
        {
          "body": "m2",
          "redelivered": false
        }
      ]
    },
    "ready": {
      "jobs": []
    }
  }
}
