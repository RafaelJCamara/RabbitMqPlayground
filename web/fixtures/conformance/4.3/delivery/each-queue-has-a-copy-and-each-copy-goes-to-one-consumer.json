{
  "id": "delivery/each-queue-has-a-copy-and-each-copy-goes-to-one-consumer",
  "kind": "delivery",
  "title": "A message that two queues receive is delivered once from each queue, and where a queue has two consumers, to one of them (ADR-0008, rules 7 and 13)",
  "steps": [
    {
      "op": "exchange.declare",
      "name": "e",
      "type": "fanout"
    },
    {
      "op": "queue.declare",
      "name": "q1",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "q2",
      "durable": true
    },
    {
      "op": "bind",
      "source": "e",
      "destination": {
        "kind": "queue",
        "name": "q1"
      },
      "key": ""
    },
    {
      "op": "bind",
      "source": "e",
      "destination": {
        "kind": "queue",
        "name": "q2"
      },
      "key": ""
    },
    {
      "op": "channel.open",
      "channel": "ch1"
    },
    {
      "op": "channel.open",
      "channel": "ch2"
    },
    {
      "op": "channel.open",
      "channel": "ch3"
    },
    {
      "op": "basic.consume",
      "channel": "ch1",
      "queue": "q1",
      "consumer": "c1",
      "ack": "auto"
    },
    {
      "op": "basic.consume",
      "channel": "ch2",
      "queue": "q2",
      "consumer": "c2",
      "ack": "auto"
    },
    {
      "op": "basic.consume",
      "channel": "ch3",
      "queue": "q1",
      "consumer": "c3",
      "ack": "auto"
    },
    {
      "op": "basic.publish",
      "exchange": "e",
      "key": "",
      "body": "m1"
    },
    {
      "op": "basic.publish",
      "exchange": "e",
      "key": "",
      "body": "m2"
    },
    {
      "op": "await.deliveries",
      "count": 4
    }
  ],
  "observed": {
    "deliveries": {
      "c1": [
        {
          "body": "m1",
          "redelivered": false
        }
      ],
      "c2": [
        {
          "body": "m1",
          "redelivered": false
        },
        {
          "body": "m2",
          "redelivered": false
        }
      ],
      "c3": [
        {
          "body": "m2",
          "redelivered": false
        }
      ]
    },
    "ready": {
      "q1": [],
      "q2": []
    }
  }
}
