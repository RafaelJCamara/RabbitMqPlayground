{
  "id": "delivery/requeued-messages-go-back-in-their-places",
  "kind": "delivery",
  "title": "The messages of a channel that is closed go back to the front of their queue in their old order, redelivered, ahead of what came after them (ADR-0008, rule 16)",
  "steps": [
    {
      "op": "queue.declare",
      "name": "jobs",
      "durable": true
    },
    {
      "op": "channel.open",
      "channel": "ch1",
      "prefetch": 3
    },
    {
      "op": "channel.open",
      "channel": "ch2"
    },
    {
      "op": "basic.consume",
      "channel": "ch1",
      "queue": "jobs",
      "consumer": "c1",
      "ack": "manual"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m1"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m2"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m3"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m4"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "jobs",
      "body": "m5"
    },
    {
      "op": "await.deliveries",
      "count": 3
    },
    {
      "op": "channel.close",
      "channel": "ch1"
    },
    {
      "op": "basic.consume",
      "channel": "ch2",
      "queue": "jobs",
      "consumer": "c2",
      "ack": "auto"
    },
    {
      "op": "await.deliveries",
      "count": 8
    }
  ],
  "observed": {
    "deliveries": {
      "c1": [
        {
          "body": "m1",
          "redelivered": false
        },
        {
          "body": "m2",
          "redelivered": false
        },
        {
          "body": "m3",
          "redelivered": false
        }
      ],
      "c2": [
        {
          "body": "m1",
          "redelivered": true
        },
        {
          "body": "m2",
          "redelivered": true
        },
        {
          "body": "m3",
          "redelivered": true
        },
        {
          "body": "m4",
          "redelivered": false
        },
        {
          "body": "m5",
          "redelivered": false
        }
      ]
    },
    "ready": {
      "jobs": []
    }
  }
}
