{
  "id": "routing/exchange-to-exchange-bindings-follow-chains-and-survive-cycles",
  "kind": "routing",
  "title": "Exchange-to-exchange bindings are followed, a cycle terminates, and a queue gets at most one copy (ADR-0008, rule 7)",
  "steps": [
    {
      "op": "exchange.declare",
      "name": "e1",
      "type": "fanout"
    },
    {
      "op": "exchange.declare",
      "name": "e2",
      "type": "fanout"
    },
    {
      "op": "exchange.declare",
      "name": "e3",
      "type": "fanout"
    },
    {
      "op": "queue.declare",
      "name": "qa",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "qb",
      "durable": true
    },
    {
      "op": "bind",
      "source": "e1",
      "destination": {
        "kind": "exchange",
        "name": "e2"
      },
      "key": ""
    },
    {
      "op": "bind",
      "source": "e2",
      "destination": {
        "kind": "exchange",
        "name": "e3"
      },
      "key": ""
    },
    {
      "op": "bind",
      "source": "e3",
      "destination": {
        "kind": "exchange",
        "name": "e1"
      },
      "key": ""
    },
    {
      "op": "bind",
      "source": "e2",
      "destination": {
        "kind": "queue",
        "name": "qa"
      },
      "key": ""
    },
    {
      "op": "bind",
      "source": "e3",
      "destination": {
        "kind": "queue",
        "name": "qb"
      },
      "key": ""
    },
    {
      "op": "bind",
      "source": "e1",
      "destination": {
        "kind": "queue",
        "name": "qa"
      },
      "key": ""
    },
    {
      "op": "basic.publish",
      "exchange": "e1",
      "key": "",
      "body": "m1"
    },
    {
      "op": "basic.publish",
      "exchange": "e2",
      "key": "",
      "body": "m2"
    },
    {
      "op": "basic.publish",
      "exchange": "e3",
      "key": "",
      "body": "m3"
    }
  ],
  "observed": {
    "routes": [
      {
        "body": "m1",
        "returned": false,
        "queues": [
          "qa",
          "qb"
        ]
      },
      {
        "body": "m2",
        "returned": false,
        "queues": [
          "qa",
          "qb"
        ]
      },
      {
        "body": "m3",
        "returned": false,
        "queues": [
          "qa",
          "qb"
        ]
      }
    ]
  }
}
