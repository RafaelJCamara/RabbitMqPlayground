{
  "id": "routing/topic-wildcards-match-whole-words",
  "kind": "routing",
  "title": "A topic exchange splits keys into words: * is one word (possibly empty), # is zero or more (ADR-0008, rule 4)",
  "steps": [
    {
      "op": "exchange.declare",
      "name": "events",
      "type": "topic"
    },
    {
      "op": "queue.declare",
      "name": "star",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "hash",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "everything",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "middle",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "between",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "literal",
      "durable": true
    },
    {
      "op": "bind",
      "source": "events",
      "destination": {
        "kind": "queue",
        "name": "star"
      },
      "key": "a.*"
    },
    {
      "op": "bind",
      "source": "events",
      "destination": {
        "kind": "queue",
        "name": "hash"
      },
      "key": "a.#"
    },
    {
      "op": "bind",
      "source": "events",
      "destination": {
        "kind": "queue",
        "name": "everything"
      },
      "key": "#"
    },
    {
      "op": "bind",
      "source": "events",
      "destination": {
        "kind": "queue",
        "name": "middle"
      },
      "key": "a.#.b"
    },
    {
      "op": "bind",
      "source": "events",
      "destination": {
        "kind": "queue",
        "name": "between"
      },
      "key": "a.*.b"
    },
    {
      "op": "bind",
      "source": "events",
      "destination": {
        "kind": "queue",
        "name": "literal"
      },
      "key": "a*"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "a",
      "body": "m1"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "a.b",
      "body": "m2"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "a.b.c",
      "body": "m3"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "a..b",
      "body": "m4"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "",
      "body": "m5"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "a.x.y.b",
      "body": "m6"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "a*",
      "body": "m7"
    },
    {
      "op": "basic.publish",
      "exchange": "events",
      "key": "b",
      "body": "m8"
    }
  ],
  "observed": {
    "routes": [
      {
        "body": "m1",
        "returned": false,
        "queues": [
          "hash",
          "everything"
        ]
      },
      {
        "body": "m2",
        "returned": false,
        "queues": [
          "star",
          "hash",
          "everything",
          "middle"
        ]
      },
      {
        "body": "m3",
        "returned": false,
        "queues": [
          "hash",
          "everything"
        ]
      },
      {
        "body": "m4",
        "returned": false,
        "queues": [
          "hash",
          "everything",
          "middle",
          "between"
        ]
      },
      {
        "body": "m5",
        "returned": false,
        "queues": [
          "everything"
        ]
      },
      {
        "body": "m6",
        "returned": false,
        "queues": [
          "hash",
          "everything",
          "middle"
        ]
      },
      {
        "body": "m7",
        "returned": false,
        "queues": [
          "everything",
          "literal"
        ]
      },
      {
        "body": "m8",
        "returned": false,
        "queues": [
          "everything"
        ]
      }
    ]
  }
}
