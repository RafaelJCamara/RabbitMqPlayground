{
  "id": "routing/headers-a-queue-bound-with-several-matching-bindings-gets-one-copy",
  "kind": "routing",
  "title": "A queue that is bound with several bindings that all match, or with the same binding twice, still gets one copy (ADR-0008, rule 7)",
