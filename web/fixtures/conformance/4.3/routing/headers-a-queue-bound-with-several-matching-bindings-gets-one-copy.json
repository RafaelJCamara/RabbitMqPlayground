      "op": "bind",
      "source": "h",
      "destination": {
        "kind": "queue",
        "name": "two"
      },
      "key": "",
      "headers": {
        "xMatch": "all",
        "args": [
          {
            "key": "a",
            "value": {
              "t": "integer",
              "v": 1
            }
          }
        ]
      }
    },
    {
      "op": "bind",
      "source": "h",
      "destination": {
        "kind": "queue",
        "name": "two"
