      "body": "m9"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "é",
      "body": "m10"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "é",
      "body": "m11"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "other",
      "body": "m12"
    },
    {
      "op": "basic.publish",
      "exchange": "alpha",
      "key": "alpha",
      "body": "m13"
    },
    {
      "op": "basic.publish",
      "exchange": "elsewhere",
      "key": "other",
      "body": "m14"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "alpha",
      "body": "m15",
      "headers": [
        {
          "key": "a",
          "value": {
            "t": "integer",
            "v": 1
          }
        }
      ]
    }
  ],
