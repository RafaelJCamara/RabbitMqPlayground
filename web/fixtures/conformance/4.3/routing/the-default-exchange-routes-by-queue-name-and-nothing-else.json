{
  "id": "routing/the-default-exchange-routes-by-queue-name-and-nothing-else",
  "kind": "routing",
  "title": "The default exchange routes by the exact name of a queue: case, spaces and dots count, a pattern is not one, and a binding elsewhere does not change it (ADR-0008, rule 6)",
  "steps": [
    {
      "op": "queue.declare",
      "name": "alpha",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "ALPHA",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "a.b",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "a.*",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "#",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "with space",
      "durable": true
    },
    {
      "op": "queue.declare",
      "name": "é",
      "durable": true
    },
    {
      "op": "exchange.declare",
      "name": "alpha",
      "type": "fanout"
    },
    {
      "op": "exchange.declare",
      "name": "elsewhere",
      "type": "direct"
    },
    {
      "op": "bind",
      "source": "elsewhere",
      "destination": {
        "kind": "queue",
        "name": "alpha"
      },
      "key": "other"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "alpha",
      "body": "m1"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "ALPHA",
      "body": "m2"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "a.b",
      "body": "m3"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "a.*",
      "body": "m4"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "a.x",
      "body": "m5"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "#",
      "body": "m6"
    },
    {
      "op": "basic.publish",
      "exchange": "",
      "key": "anything",
      "body": "m7"
    },
    {
      "op": "basic.publish",
      "exchange": "",
