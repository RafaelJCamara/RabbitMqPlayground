{
  "id": "routing/headers-the-routing-key-is-ignored",
  "kind": "routing",
  "title": "A headers exchange does not look at the routing key: any key on the binding or on the message, and the same message reaches a queue once per queue (ADR-0009)",
  "steps": [
    {
      "op": "exchange.declare",
      "name": "h",
      "type": "headers"
    },
    {
      "op": "queue.declare",
      "name": "key foo",
      "durable": true
    },
    {
      "op": "bind",
      "source": "h",
      "destination": {
        "kind": "queue",
        "name": "key foo"
      },
      "key": "foo",
      "headers": {
        "xMatch": "all",
        "args": [
          {
            "key": "a",
            "value": {
              "t": "integer",
              "v": 1
            }
          }
        ]
      }
    },
    {
      "op": "queue.declare",
      "name": "key bar",
      "durable": true
    },
    {
      "op": "bind",
      "source": "h",
      "destination": {
        "kind": "queue",
        "name": "key bar"
      },
      "key": "bar",
      "headers": {
        "xMatch": "all",
        "args": [
          {
            "key": "a",
            "value": {
              "t": "integer",
              "v": 1
            }
          }
        ]
      }
    },
    {
      "op": "queue.declare",
      "name": "no key",
      "durable": true
    },
    {
      "op": "bind",
      "source": "h",
      "destination": {
        "kind": "queue",
        "name": "no key"
      },
      "key": "",
      "headers": {
        "xMatch": "all",
        "args": [
          {
            "key": "a",
            "value": {
              "t": "integer",
              "v": 1
            }
          }
        ]
      }
    },
    {
      "op": "queue.declare",
      "name": "other args",
      "durable": true
    },
    {
      "op": "bind",
      "source": "h",
      "destination": {
        "kind": "queue",
        "name": "other args"
      },
      "key": "foo",
      "headers": {
        "xMatch": "all",
        "args": [
          {
            "key": "a",
            "value": {
              "t": "integer",
              "v": 2
            }
          }
        ]
      }
    },
    {
      "op": "basic.publish",
      "exchange": "h",
      "key": "foo",
      "body": "key foo",
      "headers": [
        {
          "key": "a",
          "value": {
            "t": "integer",
            "v": 1
          }
        }
      ]
    },
    {
      "op": "basic.publish",
      "exchange": "h",
      "key": "bar",
      "body": "key bar",
      "headers": [
        {
          "key": "a",
          "value": {
            "t": "integer",
            "v": 1
          }
        }
      ]
    },
    {
      "op": "basic.publish",
      "exchange": "h",
      "key": "",
      "body": "no key",
      "headers": [
        {
          "key": "a",
          "value": {
            "t": "integer",
            "v": 1
          }
        }
      ]
    },
    {
      "op": "basic.publish",
      "exchange": "h",
      "key": "foo",
      "body": "key foo, a=2",
      "headers": [
        {
          "key": "a",
          "value": {
            "t": "integer",
            "v": 2
          }
        }
      ]
    },
    {
      "op": "basic.publish",
      "exchange": "h",
      "key": "foo",
      "body": "key foo, no headers"
    }
  ],
  "observed": {
    "routes": [
      {
        "body": "key foo",
        "returned": false,
        "queues": [
          "key foo",
          "key bar",
          "no key"
        ]
      },
      {
        "body": "key bar",
        "returned": false,
        "queues": [
          "key foo",
          "key bar",
          "no key"
        ]
      },
      {
        "body": "no key",
        "returned": false,
        "queues": [
          "key foo",
          "key bar",
          "no key"
        ]
      },
      {
        "body": "key foo, a=2",
        "returned": false,
        "queues": [
          "other args"
        ]
      },
      {
        "body": "key foo, no headers",
        "returned": true,
        "queues": []
      }
    ]
  }
}
