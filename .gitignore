## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
# ...but the notes of our own releases are documents (docs/releases/v0.1.0.md).
!/docs/releases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

## ---------------------------------------------------------------------------
## Node, Angular and test output (the web/ workspace)
## ---------------------------------------------------------------------------

# Dependencies
node_modules/
npm-debug.log*
yarn-error.log*

# Build output and caches
/web/dist/
/web/.angular/
/web/.tsbuild/
*.tsbuildinfo

# Test and tool output
/web/coverage/
/web/playwright-report/
/web/test-results/
/web/blob-report/
/web/bench-results/
/web/conformance-diff/

# The .NET patterns at the top ignore any directory called bin, obj, log(s), debug or release, wherever it is.
# Source folders in web/ may use those names, so they are never ignored there. Build output and node_modules stay
# ignored, because git cannot re-include a file whose parent directory is ignored.
!/web/**/[Bb]in/
!/web/**/[Oo]bj/
!/web/**/[Ll]og/
!/web/**/[Ll]ogs/
!/web/**/[Dd]ebug/
!/web/**/[Rr]elease/
!/web/**/[Rr]eleases/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code: personal settings stay local, the shared hook and settings are committed
.claude/settings.local.json

# Playwright MCP browser output (kept out of the repo)
.playwright-mcp/
